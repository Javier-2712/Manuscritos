DataInfo(as.list(mat_sitio),  datatype = "abundance") %>%
  kable(digits = 3, caption = "Completitud muestral (cobertura, SC) por Sitio")

DataInfo(as.list(mat_franja), datatype = "abundance") %>%
  kable(digits = 3, caption = "Completitud muestral (cobertura, SC) por Franja")

set.seed(2026)
out_sitio  <- iNEXT(as.list(mat_sitio),  q = c(0,1,2), datatype = "abundance")
out_franja <- iNEXT(as.list(mat_franja), q = c(0,1,2), datatype = "abundance")

ggiNEXT(out_franja, type = 1, facet.var = "Order.q") + theme_bw(base_size = 10)
